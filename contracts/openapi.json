{
  "openapi": "3.1.0",
  "info": {
    "title": "Workshop execution",
    "version": "fase-4-local",
    "description": "Rotas geradas dos controllers; seguranca e prefixo local documentados na publicacao."
  },
  "servers": [
    {
      "url": "/execution",
      "description": "Gateway local"
    }
  ],
  "paths": {
    "/api/v1/trabalhos/{id}/reparo/iniciar": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "startRepair",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}/reparo/concluir": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "finishRepair",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}/itens/{itemId}/iniciar": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "startItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}/itens/{itemId}/concluir": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "finishItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}/diagnostico/iniciar": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "startDiagnostic",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}/diagnostico/concluir": {
      "post": {
        "tags": [
          "work-api"
        ],
        "operationId": "finishDiagnostic",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Diagnostic"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos": {
      "get": {
        "tags": [
          "work-api"
        ],
        "operationId": "queue",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "DIAGNOSTICO_PENDENTE"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Work"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trabalhos/{id}": {
      "get": {
        "tags": [
          "work-api"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Work"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Change": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Work": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "osId": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "sagaId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "request": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "diagnostic": {
            "type": "string"
          },
          "mechanicId": {
            "type": "string"
          },
          "budgetId": {
            "type": "string"
          },
          "budgetVersion": {
            "type": "integer",
            "format": "int32"
          },
          "paymentId": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "diagnostico": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}